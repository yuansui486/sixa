{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "私匣",
  "version": "1.0.9",
  "identifier": "cn.shierkeji.sixa",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "私匣 · 本机数据脱敏",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../crates/formats/assets/fonts/OFL.txt": "licenses/NotoSansSC-OFL.txt",
      "../licenses/docx-preview-LICENSE.txt": "licenses/docx-preview-LICENSE.txt",
      "../licenses/jszip-LICENSE.txt": "licenses/jszip-LICENSE.txt"
    },
    "shortDescription": "私匣 · 本机离线中文数据脱敏",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwOUQ4RTBBMzVDM0RFOUYKUldTZjNzTTFDbzZkTUgwUitsQUEzNlVjZDRFaU1Idmt5TEs3bnF2bk9PT29NMFR5anJxZ0pweHMK",
      "endpoints": [
        "https://tct12.oss-cn-beijing.aliyuncs.com/12box/sixa/updates/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
